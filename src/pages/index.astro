---
import Layout from '../layouts/Layout.astro';
import SideNav from '../components/SideNav.astro';
import HeroScrub from '../components/HeroScrub.astro';
import GridStagger from '../components/GridStagger.astro';
import ParallaxType from '../components/ParallaxType.astro';
import PinHorizontal from '../components/PinHorizontal.astro';
import MarqueeLoop from '../components/MarqueeLoop.astro';
import FooterCurtain from '../components/FooterCurtain.astro';
---

<Layout>
  <SideNav />

  <main>
    <HeroScrub />
    <GridStagger />
    <ParallaxType />
    <PinHorizontal />
    <MarqueeLoop />
    <FooterCurtain />
  </main>
</Layout>
